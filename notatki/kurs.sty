% Nagłówek rozdziału-modułu: cel, czas, katalog
\newcommand{\metryczka}[3]{%
  \begin{tcolorbox}[enhanced, boxrule=0.5pt, colframe=akcent!50, colback=white,
    arc=2pt, left=8pt, right=8pt, top=4pt, bottom=4pt]
  \small\sffamily
  \begin{tabularx}{\linewidth}{@{}l X@{}}
  \textbf{Cel:} & #1 \\
  \textbf{Czas:} & #2 \\
  \textbf{Katalog:} & \plik{#3} \\
  \end{tabularx}
  \end{tcolorbox}}

