% Multiplekser 2:1 jako "pic": \pic (m) at (x,y) {muks};
% współrzędne: m-in0, m-in1 (lewa strona), m-sel (dół), m-out (prawa)
\tikzset{muks/.pic={
  \draw[thick, fill=white] (-2mm,-6mm) -- (-2mm,6mm) -- (2mm,3.5mm) -- (2mm,-3.5mm) -- cycle;
  \coordinate (-in1) at (-2mm,3mm);  \coordinate (-in0) at (-2mm,-3mm);
  \coordinate (-sel) at (0,-4.8mm);  \coordinate (-out) at (2mm,0);
  \node[font=\sffamily\tiny, inner sep=0] at (-1.1mm,3mm) {1};
  \node[font=\sffamily\tiny, inner sep=0] at (-1.1mm,-3mm) {0};
}}

% Przebieg czasowy: \zegar{liczba okresów}{y}
\newcommand{\zegar}[3][1]{% #1 szer. półokresu, #2 okresy, #3 y
  \foreach \i in {1,...,#2} {
    \draw[thick] ({(\i-1)*2*#1},#3) -- ++(0,0.5) -- ++(#1,0) -- ++(0,-0.5) -- ++(#1,0);
  }}

