% ---- listingi ----------------------------------------------------------------
\RequirePackage{listings}
\lstdefinelanguage{SV}{
  morekeywords={module,endmodule,input,output,inout,logic,wire,reg,bit,int,
    integer,parameter,localparam,assign,always,always_comb,always_ff,
    always_latch,begin,end,if,else,case,endcase,default,for,generate,
    endgenerate,genvar,posedge,negedge,or,and,not,initial,function,
    endfunction,task,endtask,automatic,return,typedef,enum,struct,packed,
    package,endpackage,import,unique,priority,while,repeat,forever,fork,
    join,signed,unsigned,string,void,real},
  morekeywords=[2]{$display,$finish,$signed,$unsigned,$clog2,$urandom,
    $readmemh,$dumpfile,$dumpvars,$fopen,$fclose,$fscanf,$fdisplay,
    $sformatf,$time,$isunknown,$value$plusargs,$test$plusargs,$write},
  sensitive=true,
  morecomment=[l]{//},
  morecomment=[s]{/*}{*/},
  morestring=[b]",
  alsoletter={\$},
}
\lstdefinelanguage{RVASM}{
  morekeywords={add,addi,sub,sll,slli,slt,slti,sltu,sltiu,xor,xori,srl,srli,
    sra,srai,or,ori,and,andi,lui,auipc,jal,jalr,beq,bne,blt,bge,bltu,bgeu,
    lb,lh,lw,lbu,lhu,sb,sh,sw,li,la,mv,nop,j,jr,ret,call,beqz,bnez,bgt,ble,
    bgtz,blez,mul,div,rem,fence,ecall,ebreak,csrrw,mret},
  morekeywords=[2]{.include,.equ,.word,.byte,.half,.space,.align,.asciz,
    .section,.globl,.org},
  sensitive=false,
  morecomment=[l]{\#},
  morestring=[b]",
  alsoletter={.},
}
\lstset{
  basicstyle=\ttfamily\small,
  keywordstyle=\color{slowo}\bfseries,
  keywordstyle=[2]\color{liczba},
  commentstyle=\color{komentarz}\itshape,
  stringstyle=\color{napis},
  backgroundcolor=\color{kodtlo},
